# Copy to docker-compose.override.yml (gitignored) for local tweaks. Compose
# merges it over docker-compose.yml automatically, so nothing needs to change
# in the committed file — and your local settings never end up in a commit.

services:
  pagesnap:
    # A bind mount instead of the named volume, when you want to open the
    # screenshots and the batch ZIP straight from your file manager rather than
    # copying them out of a volume with `docker cp`.
    volumes:
      - ./data:/app/data

    environment:
      # Retina captures. Worth it only with plenty of RAM: at 2x, stitching a
      # tall page can need several GB and the container gets OOM-killed.
      PAGESNAP_MAX_SCALE: "2"

    # Caps how much of the machine a batch running ten captures at once can
    # take. Without a limit, ten Chromium instances will happily use everything.
    deploy:
      resources:
        limits:
          memory: 8g
