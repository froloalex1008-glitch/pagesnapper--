# Copy to .env (local) or set these as environment variables on your host.
# Every one is optional — with none set, the app runs open on port 3000 at full 2x scale.

# Login. Set BOTH to enable the sign-in page. Required (the server refuses to
# start without them) whenever FLOWHUNT_API_KEY is set or the app is hosted —
# otherwise anyone with the URL can spend FlowHunt credits and read the exports.
# Password must be at least 12 characters.
PAGESNAP_USERNAME=
PAGESNAP_PASSWORD=
# Optional. Changing it signs every browser out without changing the password.
PAGESNAP_SESSION_SECRET=

# Caps the capture scale factor. Set to 1 on memory-limited hosts (e.g. a small
# Railway container): 2x quadruples the pixels the stitcher has to composite and
# is the difference between finishing and being OOM-killed on heavy pages.
PAGESNAP_MAX_SCALE=

# Where PNGs are written. Point this at a mounted volume to survive redeploys.
SCREENSHOT_DIR=

# Hard ceiling on a single capture, in milliseconds. Default 480000 (8 minutes).
CAPTURE_TIMEOUT_MS=

# Port to listen on. Most hosts inject this automatically.
PORT=

# FlowHunt batch defaults. Optional — the Batch tab accepts them typed in, but
# with these set the fields can stay blank and the flow list loads by itself.
# API key: FlowHunt workspace settings → API keys. Workspace ID: the ws= value
# in any FlowHunt URL. Flow ID: the UUID in the URL of the open flow.
FLOWHUNT_API_KEY=
FLOWHUNT_WORKSPACE_ID=
FLOWHUNT_FLOW_ID=
